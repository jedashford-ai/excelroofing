---
import IntroLogo from "../components/IntroLogo.astro";
const whatsappMessage = "Hi Stuart, I'd like to discuss some roofing work and get a quote. Can you help?";
const whatsappUrl = `https://wa.me/447973673255?text=${encodeURIComponent(whatsappMessage)}`;
const projects = [
 { image:'hero', title:'A clean finish. Every edge.', detail:'Flat roof · Brick extension' },
 { image:'rooflight', title:'Let the daylight in.', detail:'Rooflight · Flat roof detailing' },
 { image:'overview', title:'Built around your home.', detail:'Flat roofing · Home extension' },
 { image:'skylight', title:'The details make the difference.', detail:'Rooflight · Side extension' }
];
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#10264d"/><title>Excel Roofing | Flat roofing since 1989</title><meta name="description" content="Excel Roofing. Flat roofing, repairs and rooflights in Lichfield and Staffordshire. Established in 1989. Discuss your roof and request a quote."/><link rel="icon" href="/images/logo.svg" type="image/svg+xml"/><link rel="preload" as="image" href="/images/hero.jpg"/><link rel="stylesheet" href="/styles.css"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div id="intro" class="intro" hidden><div class="intro-logo"><IntroLogo /></div><span class="intro-caption">CRAFT & CONFIDENCE · SINCE 1989</span><button id="skip-intro" tabindex="-1">Skip intro</button></div>
<header class="header"><a class="brand" href="#" aria-label="Excel Roofing home"><img id="header-logo" src="/images/logo.svg" alt="Excel Roofing — Flat Roofing Specialist" width="170" height="122"/></a><span class="est">Established 1989</span><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>＋</span></button><nav id="navigation" aria-label="Main navigation"><a href="#services">Services</a><a href="#work">Our work</a><a href="#about">About</a><a href="#contact">Contact</a><a class="button button-navy" href="tel:07973673255">Call Stuart</a></nav></header>
<main id="main">
<section class="hero" aria-labelledby="hero-heading"><img class="hero-image" src="/images/hero.jpg" alt="Completed flat roof on a brick home extension" width="1478" height="1064" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">LICHFIELD & STAFFORDSHIRE</p><h1 id="hero-heading">Flat roofing.<br/><span>Since 1989.</span></h1><p class="hero-copy">Expertise above.<br/>Peace of mind below.</p><p class="hero-description">Flat roof repairs, replacements and rooflights.<br class="desktop-break"/> Care and experience, from the first conversation.</p><div class="hero-actions"><a class="button button-blue" href="#contact">Talk to Stuart</a><a class="text-link" href="#work">View our work</a></div></div><div class="hero-bottom"><span>LOCAL KNOWLEDGE. LASTING CRAFT.</span></div></section>
<div class="service-strip"><a href="#flat-roofing">Flat roofing</a><a href="#repairs">Roof repairs</a><a href="#rooflights">Rooflights</a></div>
<section class="about section" id="about"><div class="about-copy reveal"><p class="eyebrow">EXPERIENCE THAT SHOWS</p><h2>Established locally.<br/>Built on experience.</h2><p class="lead">Looking after local roofs since 1989.</p><p>Excel Roofing is run by Stuart. From a small repair to a replacement flat roof, he takes the time to understand what your home needs. Speak to him directly for considered advice and a clear conversation about the work.</p><a class="text-link dark" href="#contact">Talk to Stuart about your roof</a><div class="signature"><span class="year">1989</span><span>Our story started here.<br/>Our work continues above you.</span></div></div><figure class="about-image reveal"><img src="/images/overview.jpg" alt="Completed flat roof on a white-rendered extension beside traditional brick homes" width="1100" height="792" loading="lazy"/><figcaption>THE FINISH IS IN THE DETAIL <span>01 / EXCEL ROOFING</span></figcaption></figure></section>
<section class="services section" id="services"><div class="section-heading reveal"><div><p class="eyebrow">WHAT WE DO</p><h2>Good roofs.<br/>Thought through.</h2></div><p>Practical solutions for the roof you have<br class="desktop-break"/> and the home you want to protect.</p></div><div class="service-grid"><a href="#contact" aria-label="Discuss flat roofing with Stuart" class="service-card reveal" id="flat-roofing"><span class="number">01</span><svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 20 32 8l26 12-26 12L6 20Zm0 8 26 12 26-12M6 36l26 12 26-12"/></svg><h3>Flat roofing</h3><p><span class="service-description-long">New flat roofs and replacements for extensions, garages and the spaces that make your house a home.</span><span class="service-description-short">New and replacement flat roofs for extensions and garages.</span></p><span class="text-link dark">Discuss your project</span></a><a href="#contact" aria-label="Discuss roof repairs with Stuart" class="service-card reveal" id="repairs"><span class="number">02</span><svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 24 26-18 26 18M14 20v25h36V20M28 23l-5 10h11l-5 10"/></svg><h3>Roof repairs</h3><p><span class="service-description-long">A leak, worn finish or an area of concern? We’ll help you understand the problem and the next step.</span><span class="service-description-short">Leaks or wear? Get advice on the problem and the next step.</span></p><span class="text-link dark">Tell us what’s wrong</span></a><a href="#contact" aria-label="Discuss rooflights with Stuart" class="service-card reveal" id="rooflights"><span class="number">03</span><svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 32 22-18 28 11-21 19L7 32Zm0 0v6l29 10 21-17v-6M31 3v6M49 7l-5 6M58 14l-7 4"/></svg><h3>Rooflights</h3><p><span class="service-description-long">Bring natural light into the room below, with rooflights that sit neatly within your flat roof.</span><span class="service-description-short">Bring natural light inside with a neatly fitted rooflight.</span></p><span class="text-link dark">Let’s talk rooflights</span></a></div></section>
<section class="work section" id="work"><div class="section-heading reveal"><div><p class="eyebrow">A CLOSER LOOK</p><h2>Our work.<br/>Out in the open.</h2></div><p>A selection of Excel Roofing projects.<br/>Take a look at the finish.</p></div><div class="project-grid" id="project-grid">{projects.map((p,i)=><article class={`project project-${i}`} id={`project-${i+1}`}><div class="project-image"><img src={`/images/${p.image}.jpg`} alt={p.detail} width="1100" height="792" loading="lazy"/></div><span class="project-caption"><span><strong>{p.title}</strong><small>{p.detail}</small></span><span class="project-index">0{i+1}</span></span></article>)}</div><button class="button projects-toggle" type="button" aria-expanded="false" aria-controls="project-3 project-4" hidden>Show more projects</button></section>
<section class="process section"><div class="process-title reveal"><p class="eyebrow">FROM FIRST CALL TO FINAL DETAIL</p><h2>Let’s keep<br/>it straightforward.</h2></div><ol><li class="reveal"><span>01</span><div><h3>Tell Stuart about your roof</h3><p>Call Stuart or send him a WhatsApp message about the work you have in mind.</p></div></li><li class="reveal"><span>02</span><div><h3>Understand your options</h3><p>Stuart will discuss your roof, arrange a look where needed and talk through the work.</p></div></li><li class="reveal"><span>03</span><div><h3>A clear way forward</h3><p>Agree the scope and quote before arranging the next steps together.</p></div></li></ol></section>
<section class="contact section" id="contact"><div class="contact-copy reveal"><p class="eyebrow">START WITH A CONVERSATION</p><h2>Your roof.<br/>Let’s talk.</h2><p>Speak directly to Stuart, the person<br class="desktop-break"/> behind Excel Roofing.</p><p class="contact-intro">Whether you have a leak, need a replacement or want to talk through an idea, give Stuart a call. Prefer to send a message? You can reach him on WhatsApp too.</p><div class="contact-person"><span class="person-mark" aria-hidden="true">S</span><span><strong>Stuart</strong><small>Excel Roofing · Established 1989</small></span></div><p class="area">LICHFIELD & STAFFORDSHIRE</p></div><div class="contact-options reveal"><a class="direct-call" href="tel:07973673255" aria-label="Call Stuart on 07973 673255"><span class="contact-label">STUART’S MOBILE</span><strong>07973 673255</strong><span class="call-action"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4.8C3.8 3 3 3.8 3 4.8c0 9 7.2 16.2 16.2 16.2 1 0 1.8-.8 1.8-1.8V17l-5-2-1.8 2a13 13 0 0 1-7.2-7.2L9 8 7 3Z"/></svg><span>Tap to call Stuart</span></span></a><div class="alternative-call"><span>You can also call</span><a href="tel:01543433289">01543 433289</a></div><div class="whatsapp-contact"><p class="contact-label">PREFER TO MESSAGE?</p><h3>A few words.<br/>A photo of your roof.</h3><p>Send Stuart a message on WhatsApp. You can add photos and a little about the work you have in mind.</p><a class="button button-blue" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message Stuart on WhatsApp</a><small>A message is ready to edit before you send.</small></div></div></section>
</main>
<footer><div class="footer-main"><a href="#" aria-label="Back to top"><img src="/images/logo.svg" alt="Excel Roofing" width="175" height="126" loading="lazy"/></a><p>Flat roofing.<br/><strong>Since 1989.</strong></p><nav aria-label="Footer navigation"><a href="#services">Services</a><a href="#work">Our work</a><a href="#contact">Get in touch</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Excel Roofing Ltd.</span><span>Lichfield & Staffordshire</span><a href="/privacy">Privacy</a></div></footer>
<a class="floating-call" href="tel:07973673255" aria-label="Call Stuart on 07973 673255" hidden><span class="floating-call-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4.8C3.8 3 3 3.8 3 4.8c0 9 7.2 16.2 16.2 16.2 1 0 1.8-.8 1.8-1.8V17l-5-2-1.8 2a13 13 0 0 1-7.2-7.2L9 8 7 3Z"/></svg></span><span><small>Tap to call Stuart</small><strong>07973 673255</strong></span></a>
<script src="../scripts/site.js"></script>
</body></html>
