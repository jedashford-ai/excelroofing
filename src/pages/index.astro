---
import VanStory from "../components/VanStory.astro";
import IntroLogo from "../components/IntroLogo.astro";
const whatsappMessage = "Hi Stuart, I'd like to discuss some roofing work and get a quote. Can you help?";
const whatsappUrl = `https://wa.me/447973673255?text=${encodeURIComponent(whatsappMessage)}`;
const projects = [
 { image:'hero', title:'A clean finish. Every edge.', detail:'Flat roof · Brick extension' },
 { image:'flat-roof', title:'A finish made to last.', detail:'Flat roofing · Roof detailing' },
 { image:'overview', title:'Built around your home.', detail:'Flat roofing · Home extension' },
 { image:'extension', title:'The details make the difference.', detail:'Flat roofing · Home extension' }
];
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#10264d"/><title>Excel Roofing | Flat roofing | Established 1989</title><meta name="description" content="Excel Roofing. Flat roofing and roof repairs in Lichfield and Staffordshire. Established in 1989. Discuss your roof and request a quote."/><link rel="icon" href="/images/excel-initial.svg" type="image/svg+xml"/><link rel="preload" as="image" href="/images/hero.jpg"/><link rel="stylesheet" href="/styles.css"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div id="intro" class="intro" hidden><div class="intro-logo"><IntroLogo /></div><span class="intro-caption">CRAFT & CONFIDENCE · ESTABLISHED 1989</span></div>
<script is:inline>
  // Establish the first frame before the header and photos can paint.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const intro = document.getElementById('intro');
    let seen = false;
    try { seen = sessionStorage.getItem('excel-intro-v2') === 'seen'; } catch {}
    intro.hidden = seen && new URLSearchParams(location.search).get('intro') !== 'replay';
    if ('IntersectionObserver' in window) document.documentElement.classList.add('js-motion');
    window.excelMotionFallback = setTimeout(() => {
      intro.hidden = true;
      document.documentElement.classList.remove('js-motion');
    }, 4000);
  }
</script>
<header class="header"><a class="brand" href="#" aria-label="Excel Roofing home"><img id="header-logo" src="/images/logo.svg" alt="Excel Roofing — Flat Roofing Specialist" width="170" height="122"/></a><span class="est">Established 1989</span><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>＋</span></button><nav id="navigation" aria-label="Main navigation"><a href="#services">Services</a><a href="#work">Our work</a><a href="#about">About</a><a href="#contact">Contact</a><a class="button button-navy" href="tel:07973673255">Call Stuart</a></nav></header>
<main id="main">
<section class="hero" aria-labelledby="hero-heading"><img class="hero-image" src="/images/hero.jpg" alt="Completed flat roof on a brick home extension" width="1478" height="1064" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">LICHFIELD & STAFFORDSHIRE</p><h1 id="hero-heading"><span class="hero-title-line">Flat roofing.</span> <span class="hero-established">Established 1989.</span></h1><p class="hero-copy">Repairs and replacements.</p><div class="hero-actions"><a class="button button-blue" href="#contact">Talk to Stuart</a><a class="text-link" href="#work">View our work</a></div></div><div class="hero-bottom guarantee-position">
  <aside class="heritage-badge" aria-label="Workmanship guarantee">
    <span class="heritage-date"><span>MINIMUM</span><strong>10 years</strong></span>
    <span class="heritage-details"><strong>Workmanship<br/>guarantee</strong></span>
  </aside>
</div></section>
<section class="about section" id="about"><div class="about-copy reveal"><p class="eyebrow">EXPERIENCE THAT SHOWS</p><h2>Over 35 years of roofing<br/>in Staffordshire.</h2><p class="lead">Some of the roofs Stuart has worked on have lasted over 30 years.</p><p>Excel Roofing is run by Stuart. From a small repair to a replacement flat roof, he takes the time to understand what your home needs. Speak to him directly for considered advice and a clear conversation about the work.</p><a class="text-link dark" href="#contact">Talk to Stuart about your roof</a><div class="signature"><span class="year">1989</span><span>Our story started here.<br/>Our work continues above you.</span></div></div><VanStory /></section>
<section class="services section" id="services"><div class="section-heading reveal"><div><p class="eyebrow">WHAT WE DO</p><h2>Good roofs.<br/>Thought through.</h2></div><p>Practical solutions for the roof you have<br class="desktop-break"/> and the home you want to protect.</p></div><div class="service-grid"><a href="#contact" aria-label="Discuss flat roofing with Stuart" class="service-card reveal" id="flat-roofing"><span class="number">01</span><svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 20 32 8l26 12-26 12L6 20Zm0 8 26 12 26-12M6 36l26 12 26-12"/></svg><h3>Flat roofing</h3><p><span class="service-description-long">New flat roofs and replacements for extensions, garages and the spaces that make your house a home.</span><span class="service-description-short">New and replacement flat roofs for extensions and garages.</span></p><span class="text-link dark">Discuss your project</span></a><a href="#contact" aria-label="Discuss roof repairs with Stuart" class="service-card reveal" id="repairs"><span class="number">02</span><svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 24 26-18 26 18M14 20v25h36V20M28 23l-5 10h11l-5 10"/></svg><h3>Roof repairs</h3><p><span class="service-description-long">A leak, worn finish or an area of concern? We’ll help you understand the problem and the next step.</span><span class="service-description-short">Leaks or wear? Get advice on the problem and the next step.</span></p><span class="text-link dark">Tell us what’s wrong</span></a></div></section>
<section class="material-spotlight section" id="materials" aria-labelledby="materials-title">
  <div class="material-photo">
    <img src="/images/flat-roof.jpg" alt="Textured flat roof with a dark finished edge beside a tiled roof" loading="lazy" width="1100" height="825" />
  </div>
  <div class="material-panel">
    <span class="quality-label">Manufacturer-tested membrane</span>
    <h2 id="materials-title">Why Stuart chooses premium materials</h2>
    <p>Stuart uses Polyglass FLEXO S6 PREMIUM waterproofing membrane for flat roofing. Its polyester reinforcement gives the sheet strength, while the flexible bitumen helps it accommodate movement.</p>
    <dl class="material-specs">
      <div><dt>Watertightness</dt><dd><strong>Passed</strong><small>Before and after artificial ageing</small></dd></div>
      <div><dt>Cold flexibility</dt><dd><strong>−20°C</strong><small>Test temperature</small></dd></div>
      <div><dt>Breaking strength</dt><dd><strong>800 N / 600 N</strong><small>Lengthways / across, per 50 mm strip (±20%)</small></dd></div>
    </dl>
    <a class="material-sheet" href="https://kimeel.com/wp-content/uploads/2020/03/TEHNI%C4%8CKI-LIST-FLEXO-S6-PREMIUM.pdf#page=3">View manufacturer’s technical sheet (PDF)</a>
  </div>
</section>
<section class="work section" id="work"><div class="section-heading reveal"><div><p class="eyebrow">A CLOSER LOOK</p><h2>Our work.<br/>Out in the open.</h2></div><p>A selection of Excel Roofing projects.<br/>Take a look at the finish.</p></div><div class="project-grid" id="project-grid" role="region" aria-label="Project photographs">{projects.map((p,i)=><article class={`project project-${i}`} id={`project-${i+1}`} aria-label={`Project ${i+1} of ${projects.length}`}><div class="project-image" id={`project-photo-${i}`}><img src={`/images/${p.image}.jpg`} alt={p.detail} width="1100" height="792" loading="lazy"/></div><span class="project-caption"><span><strong>{p.title}</strong><small>{p.detail}</small></span><span class="project-index">0{i+1}</span></span>
  {i === 0 && <div class="photo-views" role="group" aria-label="Project photo view" hidden>
    <button type="button" aria-controls="project-photo-0" aria-pressed="true" data-view="overview">Overview</button>
    <button type="button" aria-controls="project-photo-0" aria-pressed="false" data-view="detail">Edge detail</button>
  </div>}
</article>)}</div><div class="project-gallery-meta"><span class="gallery-hint">Swipe to explore</span><span class="gallery-counter" aria-live="polite" aria-atomic="true" hidden>1 of {projects.length}</span>
  <div class="gallery-controls" hidden>
    <button type="button" aria-controls="project-grid" data-step="-1">Previous</button>
    <button type="button" aria-controls="project-grid" data-step="1">Next</button>
  </div>
</div></section>
<section class="contact section" id="contact"><div class="contact-copy reveal"><p class="eyebrow">START WITH A CONVERSATION</p><h2>Your roof.<br/>Let’s talk.</h2><p>Speak directly to Stuart, the person<br class="desktop-break"/> behind Excel Roofing.</p><p class="contact-intro">Whether you have a leak, need a replacement or want to talk through an idea, give Stuart a call. Prefer to send a message? You can reach him on WhatsApp too.</p><div class="contact-person"><span class="person-mark" aria-hidden="true">S</span><span><strong>Stuart</strong><small>Excel Roofing · Established 1989</small></span></div><p class="area">LICHFIELD & STAFFORDSHIRE</p></div><div class="contact-options reveal"><a class="direct-call" href="tel:07973673255" aria-label="Call Stuart on 07973 673255"><span class="contact-label">STUART’S MOBILE</span><strong>07973 673255</strong><span class="call-action"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4.8C3.8 3 3 3.8 3 4.8c0 9 7.2 16.2 16.2 16.2 1 0 1.8-.8 1.8-1.8V17l-5-2-1.8 2a13 13 0 0 1-7.2-7.2L9 8 7 3Z"/></svg><span>Tap to call Stuart</span></span></a><div class="alternative-call"><span>You can also call</span><a href="tel:01543433289">01543 433289</a></div><div class="whatsapp-contact"><p class="contact-label">PREFER TO MESSAGE?</p><h3>A few words.<br/>A photo of your roof.</h3><p>Send Stuart a message on WhatsApp. You can add photos and a little about the work you have in mind.</p><a class="button button-blue" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message Stuart on WhatsApp</a><small>A message is ready to edit before you send.</small></div>
<div class="contact-email"><span>Email Stuart</span><a href="mailto:excelroofing@hotmail.co.uk">excelroofing@hotmail.co.uk</a></div></div></section>
</main>
<footer><div class="footer-main"><a href="#" aria-label="Back to top"><img src="/images/logo.svg" alt="Excel Roofing" width="175" height="126" loading="lazy"/></a><p>Flat roofing.<br/><strong>Established 1989.</strong></p><nav aria-label="Footer navigation"><a href="#services">Services</a><a href="#work">Our work</a><a href="#contact">Get in touch</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Excel Roofing Ltd.</span><span>Lichfield & Staffordshire</span><a href="/privacy">Privacy</a></div></footer>
<a class="floating-call" href="tel:07973673255" aria-label="Call Stuart on 07973 673255" hidden><span class="floating-call-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4.8C3.8 3 3 3.8 3 4.8c0 9 7.2 16.2 16.2 16.2 1 0 1.8-.8 1.8-1.8V17l-5-2-1.8 2a13 13 0 0 1-7.2-7.2L9 8 7 3Z"/></svg></span><span><small>Tap to call Stuart</small><strong>07973 673255</strong></span></a>
<script src="../scripts/site.js"></script>
</body></html>
